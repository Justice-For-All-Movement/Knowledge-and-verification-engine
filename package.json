{
  "name": "@accountability/knowledge-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./evidence-links": {
      "types": "./dist/evidence-links.d.ts",
      "default": "./dist/evidence-links.js"
    },
    "./entity-identity": {
      "types": "./dist/entity-identity.d.ts",
      "default": "./dist/entity-identity.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "default": "./dist/repository.js"
    },
    "./identity-repository": {
      "types": "./dist/identity-repository.d.ts",
      "default": "./dist/identity-repository.js"
    },
    "./current-evidence": {
      "types": "./dist/current-evidence.d.ts",
      "default": "./dist/current-evidence.js"
    },
    "./source-links": {
      "types": "./dist/source-links.d.ts",
      "default": "./dist/source-links.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-pr-registry.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test:postgres": "npm run typecheck && node --test integration/postgres-knowledge.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "@electric-sql/pglite": "0.5.12"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "dependencies": {
    "@accountability/evidence": "git+https://github.com/neophilism/Evidence-Storage-and-Provenance-Engine.git#f13686e888c7539b86564c3709608ef5cf2ccac2",
    "@accountability/evidence-sql": "git+https://github.com/neophilism/Evidence-Storage-and-Provenance-Engine.git#dce7105a70b42d77afe4cd48d34723331447037c",
    "@accountability/identity-policy": "git+https://github.com/neophilism/Identity-Authorization-and-Policy-Engine.git#763060ddc840979b56483afd830f78679a2369b0"
  }
}
